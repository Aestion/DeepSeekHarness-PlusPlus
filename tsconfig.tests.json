{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "baseUrl": ".",
    "ignoreDeprecations": "6.0",
    "paths": {
      "@dshplusplus/multimodal": ["packages/multimodal/src/index.ts"],
      "@dshplusplus/multimodal-llm": ["packages/multimodal-llm/src/index.ts"],
      "@dshplusplus/multimodal-router": ["packages/multimodal-router/src/index.ts"],
      "@dshplusplus/compatibility": ["packages/compatibility/src/index.ts"]
    }
  },
  "include": [
    "packages/*/src/**/*.ts",
    "packages/*/tests/**/*.ts",
    "scripts/**/*.ts",
    "vitest.config.ts"
  ]
}
